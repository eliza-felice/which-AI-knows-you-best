# Copy to .env.local for local use; set the same names in Vercel for deploys.

# Model gateway (OpenAI-compatible). Required.
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_URL=https://api.apiyi.com/v1

# Cost limits (optional).
# LIVE_CALLS_ENABLED=false      # stops all live calls
# RUNS_PER_IP_PER_DAY=1         # full runs per visitor (default unlimited)
# RUNS_PER_DAY=200              # all visitors together
# WHATIFS_PER_IP_PER_DAY=10     # live what-ifs per visitor (default unlimited)
# WHATIFS_PER_DAY=1000          # live what-ifs, all visitors together

# How long a cached guess is reused (default 30 days).
# CACHE_TTL_DAYS=30

# Upstash Redis, so the limits, the guess cache and the saved responses hold
# across serverless functions (needed on Vercel). Vercel's Upstash integration
# may set KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
