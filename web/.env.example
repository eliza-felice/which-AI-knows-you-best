# Copy to .env.local for local use; set the same names in Vercel for deploys.

# Model gateway (OpenAI-compatible). Required.
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_URL=https://api.apiyi.com/v1

# Cost limits (optional).
# LIVE_CALLS_ENABLED=false      # stops all live calls
# RUNS_PER_IP_PER_DAY=1         # default 1 in production, unlimited in development
# RUNS_PER_DAY=200              # all visitors together

# How long a cached guess is reused (default 30 days).
# CACHE_TTL_DAYS=30

# Upstash Redis, so the limits and the guess cache hold across serverless
# functions (needed on Vercel).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
